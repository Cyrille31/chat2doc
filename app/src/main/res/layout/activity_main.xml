<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_chat2doc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/cg_blue"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_soft"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Écran d'accueil -->
        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/howto_title" />

            <TextView
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:padding="16dp"
                android:text="@string/howto_text" />

            <Button
                android:id="@+id/pick_zip"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pick_zip" />

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_title" />

            <RadioGroup
                android:id="@+id/quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/quality_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_small" />

                <RadioButton
                    android:id="@+id/quality_standard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_standard" />

                <RadioButton
                    android:id="@+id/quality_original"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_original" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quality_note"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Conversion en cours -->
        <LinearLayout
            android:id="@+id/working"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_title" />

            <TextView
                android:id="@+id/stage"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cancel"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cancel" />
        </LinearLayout>

        <!-- Résultat -->
        <LinearLayout
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_title" />

            <TextView
                android:id="@+id/summary"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:padding="16dp" />

            <Button
                android:id="@+id/save"
                style="@style/Chat2Doc.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save" />

            <Button
                android:id="@+id/share"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share" />

            <Button
                android:id="@+id/open_word"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_word" />

            <Button
                android:id="@+id/again"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/new_conversion"
                android:textAllCaps="false"
                android:textColor="@color/cg_blue" />
        </LinearLayout>

        <!-- Message d'erreur -->
        <TextView
            android:id="@+id/error"
            style="@style/Chat2Doc.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:backgroundTint="#FDECEA"
            android:padding="16dp"
            android:textColor="#8A1C12"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/footer"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
