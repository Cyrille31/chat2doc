<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_chat2doc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/cg_blue"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/open_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textColor="@color/cg_blue"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ========================= Accueil ========================= -->
        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card"
                android:padding="16dp"
                android:text="@string/howto_text" />

            <Button
                android:id="@+id/pick_zip"
                style="@style/Chat2Doc.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pick_zip" />

            <!-- Dossier pas encore choisi -->
            <LinearLayout
                android:id="@+id/folder_needed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card"
                android:backgroundTint="#FFF4E0"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/folder_needed_text"
                    style="@style/Chat2Doc.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/folder_needed" />

                <Button
                    android:id="@+id/folder_needed_choose"
                    style="@style/Chat2Doc.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/folder_choose" />
            </LinearLayout>

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saved_title" />

            <TextView
                android:id="@+id/saved_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/saved_empty"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/saved_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ========================= Réglages ========================= -->
        <LinearLayout
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Dossier -->
            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/folder_title" />

            <TextView
                android:id="@+id/folder_status"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <Button
                android:id="@+id/folder_choose"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/folder_choose" />

            <!-- Photos -->
            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_title" />

            <RadioGroup
                android:id="@+id/quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/quality_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_small" />

                <RadioButton
                    android:id="@+id/quality_standard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_standard" />

                <RadioButton
                    android:id="@+id/quality_original"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/quality_original" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quality_note"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <!-- Découpage -->
            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/split_title" />

            <RadioGroup
                android:id="@+id/split"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/split_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/split_none" />

                <RadioButton
                    android:id="@+id/split_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/split_year" />

                <RadioButton
                    android:id="@+id/split_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/split_auto" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/split_max_before"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/split_max"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="4"
                    android:minHeight="48dp"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/split_max_after"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/split_note"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <!-- À propos -->
            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title" />

            <TextView
                android:id="@+id/about"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:padding="16dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/source_code"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_code"
                android:textAllCaps="false"
                android:textColor="@color/cg_blue" />

            <Button
                android:id="@+id/close_settings"
                style="@style/Chat2Doc.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/back_home" />
        </LinearLayout>

        <!-- ========================= Conversion en cours ========================= -->
        <LinearLayout
            android:id="@+id/working"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Chat2Doc.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_title" />

            <TextView
                android:id="@+id/stage"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/progress_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <Button
                android:id="@+id/cancel"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cancel" />
        </LinearLayout>

        <!-- ========================= Résultat ========================= -->
        <LinearLayout
            android:id="@+id/done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/result_title"
                android:textColor="@color/ok_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary"
                style="@style/Chat2Doc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:padding="16dp" />

            <Button
                android:id="@+id/open_word"
                style="@style/Chat2Doc.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/open_word" />

            <Button
                android:id="@+id/share"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share" />

            <Button
                android:id="@+id/again"
                style="@style/Chat2Doc.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/back_home" />
        </LinearLayout>

        <!-- Message d'erreur -->
        <TextView
            android:id="@+id/error"
            style="@style/Chat2Doc.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:backgroundTint="#FDECEA"
            android:padding="16dp"
            android:textColor="#8A1C12"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/footer"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
