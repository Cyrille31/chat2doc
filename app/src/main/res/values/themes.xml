<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chat2Doc" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/cg_blue</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/cg_blue_light</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Chat2Doc.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/cg_blue</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Chat2Doc.Button.Secondary">
        <item name="android:backgroundTint">@color/cg_blue_pale</item>
        <item name="android:textColor">@color/cg_blue</item>
    </style>

    <style name="Chat2Doc.Section" parent="">
        <item name="android:textColor">@color/cg_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Chat2Doc.Body" parent="">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
